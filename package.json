{
  "name": "dungeon-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Autonomous 2D mobile fantasy RPG — top-down tile-based, turn-based combat, CC0 art, GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run tests/unit tests/property tests/replay",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:replay": "vitest run tests/replay",
    "test:soak": "vitest run tests/soak",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:soak && npm run test:e2e"
  },
  "dependencies": {
    "fast-check": "4.9.0",
    "phaser": "4.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
